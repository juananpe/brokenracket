@startuml "Book a Court"
!theme plain
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true
actor User
participant "MainUIController" as UI
participant "BlFacadeImplementation" as BL
participant "DataAccess" as DA
database "Database" as DB
User -> UI: Select Court
User -> UI: Select Date
User -> UI: Click "Find Free Slots"
activate UI
UI -> UI: handleFindFreeSlotsAction()
UI -> BL: getFreeBooks(court, bookDate)
activate BL
BL -> DA: getFreeBookingsByCourtAndDate(court, date)
activate DA
DA -> DB: Begin transaction
activate DB
DA -> DB: Execute native SQL query
note right
  SQL: SELECT * FROM Booking b 
  WHERE b.court_id = ? 
  AND YEAR(b.date) = ? 
  AND MONTH(b.date) = ? 
  AND DAY(b.date) = ? 
  AND b.status = 0
  
  Parameters:
  1. court.getNumber()
  2. year
  3. month
  4. day
end note
DB --> DA: Return result set
deactivate DB
DA -> DB: Commit transaction
activate DB
DB --> DA: Transaction committed
deactivate DB
DA --> BL: Return List<Booking>
deactivate DA
note right: JPA automatically creates Booking objects
BL --> UI: Return List<Booking>
deactivate BL
UI -> UI: Update slotsListView with bookings
UI -> UI: Update status label
UI --> User: Display available slots
deactivate UI
User -> UI: Enter member name
User -> UI: Select slot from list
User -> UI: Click "Book Selected Slot"
activate UI
UI -> UI: handleBookSelectedSlotAction()
UI -> BL: setBook(memberName, selectedBooking)
activate BL
BL -> DA: setBook(memberName, selectedBooking)
activate DA
DA -> DB: Find member by name query
activate DB
DB --> DA: Return Member entity
deactivate DB
DA -> DB: Begin transaction
activate DB
DA -> DB: find(Booking.class, bookingID)
DB --> DA: Return booking entity
DA -> DB: Update booking (set member, status)
DB --> DA: Booking updated
DA -> DB: Commit transaction
DB --> DA: Transaction committed
deactivate DB
DA --> BL: Return (success or exception)
deactivate DA
BL --> UI: Return (success or exception)
deactivate BL
UI -> UI: Update status label (success)
UI -> BL: getFreeBooks(court, bookDate)
activate BL
BL -> DA: getFreeBookingsByCourtAndDate(court, date)
activate DA
DA -> DB: Query free bookings (same as earlier)
activate DB
DB --> DA: Return updated bookings
deactivate DB
DA --> BL: Return updated List<Booking>
deactivate DA
BL --> UI: Return updated List<Booking>
deactivate BL
UI -> UI: Update slotsListView
UI --> User: Display success message and updated list
deactivate UI
@enduml