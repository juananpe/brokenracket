@startuml "Book a Court"
!theme plain
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true

actor User
participant "MainUIController" as UI
participant "BlFacadeImplementation" as BL
participant "DataAccess" as DA
participant "Court" as Court
participant "Booking" as Booking
participant "Member" as Member
database "Database" as DB

User -> UI: Select Court
User -> UI: Select Date
User -> UI: Click "Find Free Slots"
activate UI

UI -> BL: getFreeBookingsByCourtAndDate(court, date)
activate BL

BL -> DA: getFreeBookingsByCourtAndDate(court, date)
activate DA

DA -> DB: Execute SQL query for free slots
activate DB
note right
  SQL: SELECT * FROM Booking b 
  WHERE b.court_id = ? 
  AND YEAR(b.date) = ? 
  AND MONTH(b.date) = ? 
  AND DAY(b.date) = ? 
  AND b.status = 0
end note

DB --> DA: Return booking records
deactivate DB

DA -> Court: Court.getNumber()
activate Court
Court --> DA: Return court number
deactivate Court

DA -> Booking: Create Booking objects from records
activate Booking
note right: JPA creates entities
Booking --> DA: Return domain objects
deactivate Booking

DA --> BL: Return List<Booking>
deactivate DA

BL --> UI: Return List<Booking>
deactivate BL

UI --> User: Display available slots
deactivate UI

User -> UI: Enter member name
User -> UI: Select slot from list
User -> UI: Click "Book Selected Slot"
activate UI

UI -> BL: setBook(memberName, selectedBooking)
activate BL

BL -> DA: setBook(memberName, selectedBooking)
activate DA

DA -> DB: Find member by name
activate DB
DB --> DA: Return Member entity
deactivate DB

DA -> Member: member.getName()
activate Member
Member --> DA: Return name
deactivate Member

DA -> DB: Begin transaction
activate DB

alt booking has no ID (transient)
    DA -> Booking: book.getBookingID() == null
    activate Booking
    Booking --> DA: Return null ID
    deactivate Booking
    
    DA -> Booking: book.getDate(), book.getStartingHour(), book.getCourt()
    activate Booking
    Booking --> DA: Return booking details
    deactivate Booking
    
    DA -> Court: court.getId()
    activate Court
    Court --> DA: Return court ID
    deactivate Court
    
    DA -> DA: findBookingByCourtDateHour(court, date, hour)
    DA -> DB: Check for existing booking
    DB --> DA: Return booking if exists
    
    alt booking not found
        DA -> Booking: new Booking(date, hour, court, null)
        activate Booking
        Booking --> DA: Return new booking instance
        deactivate Booking
        DA -> DB: persist(persistentBooking)
    end
else booking has ID
    DA -> Booking: book.getBookingID()
    activate Booking
    Booking --> DA: Return booking ID
    deactivate Booking
    
    DA -> DB: find(Booking.class, bookingID)
    DB --> DA: Return booking entity
end

DA -> Booking: persistentBooking.getMember()
activate Booking
Booking --> DA: Return member (null or existing)
deactivate Booking

DA -> Booking: persistentBooking.setBook(member)
activate Booking
note right
  Links member to booking
  Updates bidirectional relationship
end note
Booking --> DA: Booking updated
deactivate Booking

DA -> Booking: persistentBooking.setStatus(Booking.Status.OCCUPIED)
activate Booking
Booking --> DA: Status updated
deactivate Booking

DA -> DB: Commit transaction
DB --> DA: Confirm transaction
deactivate DB

DA --> BL: Return success/throw exception
deactivate DA

BL --> UI: Return success/throw exception
deactivate BL

UI -> UI: handleFindFreeSlotsAction()
activate UI
UI -> BL: getFreeBookingsByCourtAndDate(court, date)
deactivate UI
activate BL
note right: Refresh free slots list

BL -> DA: getFreeBookingsByCourtAndDate(court, date)
activate DA
DA -> DB: Query for updated free slots
activate DB
DB --> DA: Return updated booking records
deactivate DB

DA -> Booking: Create updated Booking objects
activate Booking
Booking --> DA: Return updated domain objects
deactivate Booking

DA --> BL: Return updated List<Booking>
deactivate DA
BL --> UI: Return updated List<Booking>
deactivate BL

UI --> User: Display success message and updated slot list

@enduml